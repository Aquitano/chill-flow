{
  "name": "chill-film",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build.ts",
    "studio": "bun build.ts && remotion studio src/index.tsx",
    "render": "bun build.ts && remotion render src/index.tsx AppWalkthrough out/chill-app-walkthrough.mp4 --codec h264 --crf 18 --concurrency 1",
    "check": "tsc --noEmit",
    "capture": "cd .. && cargo test --offline -p chill ui::review::walkthrough::export_walkthrough -- --ignored --exact --nocapture",
    "build:timing": "bun prototypes/timing_options/build.ts",
    "check:timing": "tsc -p prototypes/timing_options/tsconfig.json --noEmit",
    "render:timing": "bun run build:timing && bun prototypes/timing_options/render.ts",
    "render:film": "bun run build:timing && remotion render prototypes/timing_options/index.tsx ChillFilm out/chill-refined.mp4 --codec h264 --crf 18 --concurrency 1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.539"
  }
}
