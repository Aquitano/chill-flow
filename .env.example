# These public values are resolved at runtime. In a container they can be
# changed by updating .env and recreating the app service; no image rebuild is needed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Signing secret of the Clerk webhook endpoint pointed at /api/webhooks/clerk. Without it
# a deleted account leaves its tasks, sessions, and preferences in the database.
CLERK_WEBHOOK_SIGNING_SECRET=
DATABASE_URL=postgres://user:password@host:5432/chillflow
# Optional. The runtime config endpoint safely exposes this public DSN to the browser.
SENTRY_DSN=
ALLOWED_CORS_ORIGINS=http://localhost:3000

# Public origin of the deployed app (used for server-side API calls). On Vercel this is
# inferred from VERCEL_URL if unset. Set it to your production domain for stable SSR.
NEXT_PUBLIC_APP_URL=

# Base URL the server resolves track storage keys against.
# Dev: serve audio same-origin from public/audio/. Prod: the public R2 bucket URL.
AUDIO_BASE_URL=/audio

# R2 upload backend. When all four are set, admin-dashboard uploads write to R2; otherwise
# they fall back to local public/audio/ (dev only — Vercel's filesystem is read-only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chillflow-audio
# Set to your bucket's jurisdiction if it isn't the default (e.g. "eu"); leave unset otherwise.
R2_JURISDICTION=

# Public base URL of the R2 bucket, used by `bun run audio:pull` to download files.
R2_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev

# Self-hosted deployments only (docker-compose.yml): the Cloudflare Tunnel token that fronts
# the container. See docs/SELF-HOSTING.md.
CLOUDFLARE_TUNNEL_TOKEN=
