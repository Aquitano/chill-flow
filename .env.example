NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=postgres://user:password@host:5432/chillflow
NEXT_PUBLIC_SENTRY_DSN=
ALLOWED_CORS_ORIGINS=http://localhost:3000

# Public origin of the deployed app (used for server-side API calls). On Vercel this is
# inferred from VERCEL_URL if unset. Set it to your production domain for stable SSR.
NEXT_PUBLIC_APP_URL=

# Base URL the server resolves track storage keys against.
# Dev: serve audio same-origin from public/audio/. Prod: the public R2 bucket URL.
AUDIO_BASE_URL=/audio

# R2 upload backend. When all four are set, admin-dashboard uploads write to R2; otherwise
# they fall back to local public/audio/ (dev only — Vercel's filesystem is read-only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chillflow-audio

# Public base URL of the R2 bucket, used by `bun run audio:pull` to download files.
R2_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev
